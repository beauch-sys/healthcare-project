        "quarter",
        "weekday_nursing_hprd",
        "weekend_nursing_hprd",
        "nursing_hprd_difference",
        "nursing_hprd_pct_difference",
        "weekday_rn_hprd",
        "weekend_rn_hprd",
        "rn_hprd_difference",
        "rn_hprd_pct_difference"
    ).show(10, truncate=False)
    
    
    # ==========================================
    # Enrich Weekend vs Weekday Staffing
    # ==========================================
    
    # ------------------------------------------
    # Step 1: Join facility details
    # ------------------------------------------
    
    weekend_weekday_gold_df = (
        weekend_comparison_df.alias("w")
        .join(
            facility_details_df.alias("f"),
            F.col("w.facility_id") == F.col("f.facility_id"),
            "left"
        )
        .select(
            F.col("w.*"),
            F.col("f.facility_name"),
            F.col("f.state"),
            F.col("f.ownership_type"),
            F.col("f.certified_beds"),
            F.col("f.overall_rating"),
            F.col("f.staffing_rating")
        )
    )
    
    # ------------------------------------------
    # Step 2: Add comparison indicators
    # ------------------------------------------
    
    weekend_weekday_gold_df = (
        weekend_weekday_gold_df
        .withColumn(
            "has_facility_details",
            F.col("facility_name").isNotNull()
        )
        .withColumn(
            "lower_weekend_nursing_staffing",
            F.col("nursing_hprd_difference") < 0
        )
        .withColumn(
            "lower_weekend_rn_staffing",
            F.col("rn_hprd_difference") < 0
        )
        .withColumn(
            "has_rn_pct_comparison",
            F.col("rn_hprd_pct_difference").isNotNull()
        )
    )
    
    # ------------------------------------------
    # Step 3: Validate enriched records
    # ------------------------------------------
    
    print("Weekend vs Weekday enrichment completed.")
    
    weekend_weekday_gold_df.agg(
        F.count("*").alias("total_records"),
    
        F.countDistinct("facility_id")
            .alias("unique_facilities"),
    
        F.count(
            F.when(
                F.col("facility_name").isNull(), 1
            )
        ).alias("missing_facility_details"),
    
        F.count(
            F.when(
                F.col("nursing_hprd_difference").isNull(), 1
            )
        ).alias("null_nursing_differences"),
    
        F.count(
            F.when(
                F.col("rn_hprd_pct_difference").isNull(), 1
            )
        ).alias("null_rn_pct_differences"),
    
        F.sum(
            F.when(
                F.col("lower_weekend_nursing_staffing"),
                1
            ).otherwise(0)
        ).alias("facilities_lower_on_weekends"),
    
        F.sum(
            F.when(
                F.col("lower_weekend_rn_staffing"),
                1
            ).otherwise(0)
        ).alias("facilities_lower_rn_on_weekends")
    ).show(truncate=False)
    
    weekend_weekday_gold_df.select(
        "facility_id",
        "facility_name",
        "state",
        "year",
        "quarter",
        "weekday_nursing_hprd",
        "weekend_nursing_hprd",
        "nursing_hprd_pct_difference",
        "weekday_rn_hprd",
        "weekend_rn_hprd",
        "rn_hprd_pct_difference",
        "lower_weekend_nursing_staffing"
    ).show(10, truncate=False)
    
    
    # ==========================================
    # Publish Gold: weekend_weekday_staffing
    # ==========================================
    
    weekend_table_name = "weekend_weekday_staffing"
    
    weekend_run_id = datetime.now(
        timezone.utc
    ).strftime("%Y%m%dT%H%M%S%fZ")
    
    weekend_s3_path = (
        f"s3://{S3_BUCKET}/{GOLD_PREFIX}/"
        f"{weekend_table_name}/runs/{weekend_run_id}/"
    )
    
    # ------------------------------------------
    # Step 1: Write Parquet snapshot
    # ------------------------------------------
    
    (
        weekend_weekday_gold_df
        .write
        .mode("errorifexists")
        .option("compression", "snappy")
        .parquet(weekend_s3_path)
    )
    
    print(
        f"Weekend vs Weekday data written to: "
        f"{weekend_s3_path}"
    )
    
    # ------------------------------------------
    # Step 2: Read back and validate
    # ------------------------------------------
    
    written_weekend_df = spark.read.parquet(
        weekend_s3_path
    )
    
    source_count = weekend_weekday_gold_df.count()
    written_count = written_weekend_df.count()
    
    if source_count != written_count:
        raise ValueError(
            f"Weekend comparison count mismatch: "
            f"source={source_count}, written={written_count}"
        )
    
    if written_count <= 0:
        raise ValueError(
            f"{weekend_table_name}: Output contains no records"
        )
    
    print(
        f"Weekend comparison snapshot verified: "
        f"{written_count} records"
    )
    
    # ------------------------------------------
    # Step 3: Verify S3 Parquet files
    # ------------------------------------------
    
    weekend_prefix = (
        f"{GOLD_PREFIX}/{weekend_table_name}/runs/"
        f"{weekend_run_id}/"
    )
    
    paginator = s3_client.get_paginator(
        "list_objects_v2"
    )
    
    parquet_files = []
    
    for page in paginator.paginate(
        Bucket=S3_BUCKET,
        Prefix=weekend_prefix
    ):
        parquet_files.extend(
            obj for obj in page.get("Contents", [])
            if obj["Key"].endswith(".parquet")
            and obj["Size"] > 0
        )
    
    if not parquet_files:
        raise ValueError(
            "No nonempty weekend comparison Parquet files found."
        )
    
    print(
        f"Verified {len(parquet_files)} "
        f"nonempty Parquet files."
    )
    
    # ------------------------------------------
    # Step 4: Create success marker
    # ------------------------------------------
    
    s3_client.put_object(
        Bucket=S3_BUCKET,
        Key=f"{weekend_prefix}_SUCCESS",
        Body=b""
    )
    
    print("Weekend comparison _SUCCESS marker created.")
    
    # ------------------------------------------
    # Step 5: Register Glue Catalog table
    # ------------------------------------------
    
    weekend_columns = [
        {
            "Name": field.name,
            "Type": field.dataType.simpleString()
        }
        for field in written_weekend_df.schema.fields
    ]
    
    weekend_table_input = {
        "Name": weekend_table_name,
        "TableType": "EXTERNAL_TABLE",
        "Parameters": {
            "classification": "parquet",
            "EXTERNAL": "TRUE",
            "parquet.compression": "snappy"
        },
        "StorageDescriptor": {
            "Columns": weekend_columns,
            "Location": weekend_s3_path,
            "InputFormat": (
                "org.apache.hadoop.hive.ql.io.parquet."
                "MapredParquetInputFormat"
            ),
            "OutputFormat": (
                "org.apache.hadoop.hive.ql.io.parquet."
                "MapredParquetOutputFormat"
            ),
            "SerdeInfo": {
                "SerializationLibrary": (
                    "org.apache.hadoop.hive.ql.io.parquet."
                    "serde.ParquetHiveSerDe"
                )
            }
        }
    }
    
    try:
        glue_client.get_table(
            DatabaseName=GOLD_DATABASE,
            Name=weekend_table_name
        )
    
        glue_client.update_table(
            DatabaseName=GOLD_DATABASE,
            TableInput=weekend_table_input
        )
    
        print(
            "Updated existing "
            "weekend_weekday_staffing table."
        )
    
    except glue_client.exceptions.EntityNotFoundException:
        glue_client.create_table(
            DatabaseName=GOLD_DATABASE,
            TableInput=weekend_table_input
        )
    
        print(
            "Created weekend_weekday_staffing table."
        )
    
    print(
        f"Registered {GOLD_DATABASE}."
        f"{weekend_table_name}"
    )
    
    # Additional Gold transformations will go here.
    
    job.commit()

else:
    print(
        "Gold completed successfully without processing."
    )
