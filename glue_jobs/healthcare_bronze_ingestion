        )

    print("TEST MANIFEST LOCATION VALIDATED")
    
print(f"Processing ingestion run: {run_id}")
print(f"Manifest: s3://{BUCKET}/{manifest_key}")


# --------------------------------------------------
# Detect Bronze source changes
# --------------------------------------------------

LEGACY_RUN_ID = "20261106T180437Z"

try:
    state_response = s3.get_object(
        Bucket=BUCKET,
        Key=state_key
    )

    previous_state = json.loads(
