        )
    raise


# --------------------------------------------------
# Compare manifest versions with successful baseline
# --------------------------------------------------

if previous_state.get("status") != "success":
    raise RuntimeError(
        "Pipeline baseline does not have success status."
    )


# --------------------------------------------------
# Create reproducible source-version fingerprints
# --------------------------------------------------

SOURCE_VERSION_FIELDS = (
    "google_drive_file_id",
    "google_drive_modified_time",
    "google_drive_size"
)

def source_fingerprint(source):
    version = {
        field: str(source[field])
        for field in SOURCE_VERSION_FIELDS
    }

    canonical_json = json.dumps(
        version,
        sort_keys=True,
        separators=(",", ":")
    )

    return hashlib.sha256(
        canonical_json.encode("utf-8")
    ).hexdigest()

previous_datasets = previous_state["datasets"]

changed_bronze_datasets = []

for dataset in DATASETS:

    source = manifest["datasets"][dataset]
    previous = previous_datasets.get(dataset)

    required_fields = (
        "google_drive_file_id",
        "google_drive_modified_time",
        "google_drive_size"
    )

    missing_fields = [
        field for field in required_fields
        if source.get(field) is None
    ]

    if missing_fields:
        raise RuntimeError(
            f"Manifest missing source metadata for "
            f"{dataset}: {missing_fields}"
        )

    current_version = {
        field: str(source[field])
        for field in required_fields
    }

    previous_version = (
        {
            field: str(previous.get(field))
            for field in required_fields
        }
        if previous is not None
        else None
    )

    if current_version != previous_version:

        changed_bronze_datasets.append(dataset)

        if not source.get("changed"):
            raise RuntimeError(
                f"{dataset} differs from the successful "
                f"baseline but was not marked changed "
                f"by ingestion."
            )

        if not source.get("staging_s3_key"):
            raise RuntimeError(
                f"Missing staged source for {dataset}"
            )

        print(f"BRONZE CHANGE DETECTED: {dataset}")

    else:
        print(f"BRONZE SOURCE UNCHANGED: {dataset}")

print(
    f"Bronze change detection: "
    f"{len(changed_bronze_datasets)} "
    f"of {len(DATASETS)} datasets changed."
)


# --------------------------------------------------
# Skip Bronze if sources are unchanged and
# existing published snapshots are valid
# --------------------------------------------------

if not changed_bronze_datasets:

    print("No source changes detected.")
    print("Validating existing Bronze publications.")

    glue = boto3.client("glue", region_name="us-east-1")

    for dataset in DATASETS:

        table_name = f"{dataset}_staging"

        response = glue.get_table(
            DatabaseName=DATABASE,
            Name=table_name
        )

        location = response["Table"][
            "StorageDescriptor"
        ]["Location"]

        expected_prefix = (
            f"s3://{BUCKET}/{BRONZE_PREFIX}/{dataset}/runs/"
        )
        
        legacy_test_location = (
            f"s3://{BUCKET}/bronze/{dataset}/"
            f"runs/{LEGACY_RUN_ID}/"
        )
        
        valid_location = location.startswith(expected_prefix)
        
        if (
            DATABASE == "healthcare_bronze_test"
            and BRONZE_PREFIX == "bronze-test"
            and location.rstrip("/") == legacy_test_location.rstrip("/")
        ):
            valid_location = True
        
        if not valid_location:
            raise RuntimeError(
                f"Unexpected Bronze location for "
                f"{table_name}: {location}"
            )

        snapshot_prefix = location.replace(
            f"s3://{BUCKET}/", "", 1
        ).rstrip("/") + "/"

        objects = []

        paginator = s3.get_paginator("list_objects_v2")

        for page in paginator.paginate(
            Bucket=BUCKET,
            Prefix=snapshot_prefix
        ):
            objects.extend(page.get("Contents", []))

        parquet_files = [
            obj for obj in objects
            if obj["Key"].endswith(".parquet")
            and obj["Size"] > 0
        ]

        if not parquet_files:
            raise RuntimeError(
                f"No valid Parquet files for "
                f"{table_name}"
            )

        snapshot_run_id = snapshot_prefix.rstrip(
            "/"
        ).split("/")[-1]


        # --------------------------------------------------
        # Verify published snapshot source lineage
        # --------------------------------------------------

        if snapshot_run_id == LEGACY_RUN_ID:

            legacy_prefix = (
                "bronze"
                if (
                    DATABASE == "healthcare_bronze_test"
                    and BRONZE_PREFIX == "bronze-test"
                )
                else BRONZE_PREFIX
            )
            
            expected_location = (
                f"s3://{BUCKET}/{legacy_prefix}/{dataset}/"
                f"runs/{LEGACY_RUN_ID}/"
            )

            if location.rstrip("/") != expected_location.rstrip("/"):
                raise RuntimeError(
                    f"Unexpected legacy location: {dataset}"
                )

            print(
                f"VALIDATED LEGACY LINEAGE: {dataset}"
            )

        else:

            metadata_key = (
                f"{snapshot_prefix}_source_version.json"
            )

            print(f"Dataset being validated: {dataset}")
            print(f"Looking for metadata: s3://{BUCKET}/{metadata_key}")
            
            metadata_response = s3.get_object(
                Bucket=BUCKET,
                Key=metadata_key
            )

            snapshot_metadata = json.loads(
                metadata_response["Body"].read().decode("utf-8")
            )

            expected_fingerprint = source_fingerprint(
                previous_datasets[dataset]
            )

            if (
                snapshot_metadata.get("dataset") != dataset
                or snapshot_metadata.get("ingestion_run_id")
                   != snapshot_run_id
                or snapshot_metadata.get("source_fingerprint")
                   != expected_fingerprint
            ):
                raise RuntimeError(
                    f"Published Bronze snapshot does not "
                    f"match successful baseline: {dataset}"
                )

            print(
                f"VALIDATED SOURCE FINGERPRINT: {dataset}"
            )

        if snapshot_run_id != LEGACY_RUN_ID:
            s3.head_object(
                Bucket=BUCKET,
                Key=f"{snapshot_prefix}_SUCCESS"
            )

        existing_df = spark.read.parquet(location)

        if existing_df.limit(1).count() == 0:
            raise RuntimeError(
                f"Published Bronze snapshot is empty: "
                f"{table_name}"
            )

        print(
            f"VALIDATED EXISTING: {table_name} "
            f"-> {location}"
        )

    print(
        "BRONZE SKIPPED: All five sources unchanged "
        "and existing snapshots validated."
    )

    skip_bronze = True
    
else:
    skip_bronze = False


if not skip_bronze:
    # --------------------------------------------------
    # Read and validate all five source CSVs
    # --------------------------------------------------
    
    dataframes = {}
    
    for dataset in DATASETS:
    
        if dataset not in changed_bronze_datasets:
            print(
                f"SKIPPED CSV READ: {dataset} "
                f"(source unchanged)"
            )
            continue
    
        
        # --------------------------------------------------
        # Read the exact source version from ingestion
        # --------------------------------------------------
        
        source_info = manifest["datasets"][dataset]
        
        source_key = source_info.get("staging_s3_key")
        
        if not source_key:
            raise RuntimeError(
                f"Missing run-specific staging file for changed "
                f"dataset: {dataset}. "
                f"Manifest run: {run_id}"
            )
        
        expected_prefix = (
            f"temp/drive-ingestion/{run_id}/{dataset}/"
        )
        
        if not source_key.startswith(expected_prefix):
            raise RuntimeError(
                f"Unexpected staging location for {dataset}: "
                f"{source_key}"
            )
        
        # Verify the staged file exists before Spark reads it.
        s3.head_object(
            Bucket=BUCKET,
            Key=source_key
        )
        
        source_path = f"s3://{BUCKET}/{source_key}"
        
        print(
            f"Reading changed dataset {dataset} "
            f"from immutable ingestion staging: {source_path}"
        )

    
        df = (
            spark.read
            .option("header", "true")
            .option("inferSchema", "false")
            .option("mode", "FAILFAST")
            .option("multiLine", "true")
            .option("quote", '"')
            .option("escape", '"')
            .csv(source_path)
        )
    
        if not df.columns:
            raise RuntimeError(
                f"No columns found in dataset: {dataset}"
            )
    
        # Preserve raw values as strings in Bronze.
        df = df.withColumn(
            "source_file",
            input_file_name()
        )
    
        row_count = df.count()
    
        if row_count == 0:
            raise RuntimeError(
                f"Dataset is empty: {dataset}"
            )
    
        print(
            f"{dataset}: {row_count} rows, "
            f"{len(df.columns)} columns"
        )
    
        dataframes[dataset] = df
    
    
    
    # --------------------------------------------------
    # Write or reuse completed Parquet snapshots
    # --------------------------------------------------
    
    for dataset, df in dataframes.items():
    
        prefix = f"{BRONZE_PREFIX}/{dataset}/runs/{run_id}/"
        output_path = f"s3://{BUCKET}/{prefix}"
    
        print(f"Checking Bronze snapshot: {dataset}")
    
        # Look for any existing objects in this snapshot.
        response = s3.list_objects_v2(
            Bucket=BUCKET,
            Prefix=prefix,
            MaxKeys=1
        )
    
        snapshot_exists = response.get("KeyCount", 0) > 0
    
        if snapshot_exists:
    
            # Verify that Parquet files exist.
            objects = []
    
            paginator = s3.get_paginator("list_objects_v2")
    
            for page in paginator.paginate(
                Bucket=BUCKET,
                Prefix=prefix
            ):
                objects.extend(page.get("Contents", []))
    
            # Require a completion marker for all new snapshots.
            if run_id != LEGACY_RUN_ID:
                s3.head_object(
                    Bucket=BUCKET,
                    Key=f"{prefix}_SUCCESS"
                )
                
            parquet_files = [
                obj for obj in objects
                if obj["Key"].endswith(".parquet")
                and obj["Size"] > 0
            ]
    
            if not parquet_files:
                raise RuntimeError(
                    f"No valid Parquet files found: {dataset}"
                )
    
    
            # --------------------------------------------------
            # Verify existing snapshot matches requested source
            # --------------------------------------------------
    
            metadata_key = f"{prefix}_source_version.json"
    
            metadata_response = s3.get_object(
                Bucket=BUCKET,
                Key=metadata_key
            )
    
            snapshot_metadata = json.loads(
                metadata_response["Body"].read().decode("utf-8")
            )
    
            expected_fingerprint = source_fingerprint(
                manifest["datasets"][dataset]
            )
    
            if snapshot_metadata.get("dataset") != dataset:
                raise RuntimeError(
                    f"Existing snapshot dataset mismatch: {dataset}"
                )
    
            if snapshot_metadata.get("ingestion_run_id") != run_id:
                raise RuntimeError(
                    f"Existing snapshot run mismatch: {dataset}"
                )
    
            if (
                snapshot_metadata.get("source_fingerprint")
                != expected_fingerprint
            ):
                raise RuntimeError(
                    f"Existing snapshot source mismatch: {dataset}. "
                    f"Refusing to reuse an incorrect snapshot."
                )
    
            print(
                f"EXISTING SNAPSHOT FINGERPRINT VALIDATED: {dataset}"
            )
    
            # Confirm Spark can read the existing snapshot.
            existing_df = spark.read.parquet(output_path)
    
            if existing_df.limit(1).count() == 0:
                raise RuntimeError(
                    f"Existing snapshot is empty: {dataset}"
                )
    
            print(
                f"Existing snapshot validated: {dataset}"
            )
    
        else:
        
            print(f"Writing new snapshot: {dataset}")
        
            (
                df.write
                .mode("errorifexists")
                .parquet(output_path)
            )
        
            # Record the exact source version used.
            source_info = manifest["datasets"][dataset]
        
            source_metadata = {
                "dataset": dataset,
                "ingestion_run_id": run_id,
                "source_fingerprint": source_fingerprint(
                    source_info
                ),
                "google_drive_file_id": (
                    source_info["google_drive_file_id"]
                ),
                "google_drive_modified_time": (
                    source_info["google_drive_modified_time"]
                ),
                "google_drive_size": (
                    source_info["google_drive_size"]
                ),
                "staging_s3_key": (
                    source_info["staging_s3_key"]
                )
            }
        
            metadata_key = f"{prefix}_source_version.json"
        
            s3.put_object(
                Bucket=BUCKET,
                Key=metadata_key,
                Body=json.dumps(
                    source_metadata,
                    indent=2
                ).encode("utf-8"),
                ContentType="application/json"
            )
        
            print(
                f"Source-version metadata written: "
                f"s3://{BUCKET}/{metadata_key}"
            )
        
            print(f"Finished writing: {dataset}")

    
    
    # --------------------------------------------------
    # Validate changed and unchanged Bronze snapshots
    # --------------------------------------------------
    
    snapshot_locations = {}
    
    glue = boto3.client("glue", region_name="us-east-1")
    
    for dataset in DATASETS:
    
        if dataset in changed_bronze_datasets:
    
            # Changed dataset: use current ingestion run.
            prefix = f"{BRONZE_PREFIX}/{dataset}/runs/{run_id}/"
            output_path = f"s3://{BUCKET}/{prefix}"
    
            print(f"Validating NEW snapshot: {dataset}")
    
        else:
    
            # Unchanged dataset: reuse published snapshot.
            table_name = f"{dataset}_staging"
    
            response = glue.get_table(
                DatabaseName=DATABASE,
                Name=table_name
            )
    
            output_path = response["Table"][
                "StorageDescriptor"
            ]["Location"]
    
            expected_prefix = (
                f"s3://{BUCKET}/{BRONZE_PREFIX}/{dataset}/runs/"
            )
            
            legacy_test_prefix = (
                f"s3://{BUCKET}/bronze/{dataset}/runs/"
            )
            
            valid_location = output_path.startswith(expected_prefix)
            
            if (
                DATABASE == "healthcare_bronze_test"
                and BRONZE_PREFIX == "bronze-test"
                and output_path.rstrip("/") == (
                    f"{legacy_test_prefix}{LEGACY_RUN_ID}"
                ).rstrip("/")
            ):
                valid_location = True
            
            if not valid_location:
                raise RuntimeError(
                    f"Unexpected published location for "
                    f"{dataset}: {output_path}"
                )
    
            prefix = output_path.replace(
                f"s3://{BUCKET}/", "", 1
            ).rstrip("/") + "/"
    
            print(f"Reusing EXISTING snapshot: {dataset}")
    
        # Require completion markers for nonlegacy snapshots.
        snapshot_run_id = prefix.rstrip("/").split("/")[-1]
    
    
        # --------------------------------------------------
        # Validate source lineage for this Bronze snapshot
        # --------------------------------------------------
    
        metadata_key = f"{prefix}_source_version.json"
    
        if snapshot_run_id == LEGACY_RUN_ID:
    
            # Legacy snapshots predate fingerprint metadata.
            # Only accept the established successful baseline.
    
            if dataset in changed_bronze_datasets:
                raise RuntimeError(
                    f"Changed dataset cannot reuse legacy "
                    f"snapshot: {dataset}"
                )
    
            legacy_prefix = (
                "bronze"
                if (
                    DATABASE == "healthcare_bronze_test"
                    and BRONZE_PREFIX == "bronze-test"
                )
                else BRONZE_PREFIX
            )

            expected_location = (
                f"s3://{BUCKET}/{legacy_prefix}/{dataset}/"
                f"runs/{LEGACY_RUN_ID}/"
            )
    
            if output_path.rstrip("/") != expected_location.rstrip("/"):
                raise RuntimeError(
                    f"Unexpected legacy snapshot location "
                    f"for {dataset}: {output_path}"
                )
    
            print(f"VALIDATED LEGACY LINEAGE: {dataset}")
    
        else:
    
            # All newer snapshots require source metadata.
            metadata_response = s3.get_object(
                Bucket=BUCKET,
                Key=metadata_key
            )
    
            snapshot_metadata = json.loads(
                metadata_response["Body"].read().decode("utf-8")
            )
    
            if snapshot_metadata.get("dataset") != dataset:
                raise RuntimeError(
                    f"Snapshot dataset mismatch: {dataset}"
                )
    
            if (
                snapshot_metadata.get("ingestion_run_id")
                != snapshot_run_id
            ):
                raise RuntimeError(
                    f"Snapshot run ID mismatch: {dataset}"
                )
    
            if dataset in changed_bronze_datasets:
                expected_source = manifest["datasets"][dataset]
            else:
                expected_source = previous_datasets[dataset]
    
            expected_fingerprint = source_fingerprint(
                expected_source
            )
    
            if (
                snapshot_metadata.get("source_fingerprint")
                != expected_fingerprint
            ):
                raise RuntimeError(
                    f"Source fingerprint mismatch for "
                    f"{dataset}. Snapshot does not match "
                    f"the expected source version."
                )
    
            print(f"VALIDATED SOURCE FINGERPRINT: {dataset}")

    
        if snapshot_run_id != LEGACY_RUN_ID:
            s3.head_object(
                Bucket=BUCKET,
                Key=f"{prefix}_SUCCESS"
            )
    
        # Check all objects, including paginated results.
        parquet_found = False
    
        paginator = s3.get_paginator("list_objects_v2")
    
        for page in paginator.paginate(
            Bucket=BUCKET,
            Prefix=prefix
        ):
            if any(
                obj["Key"].endswith(".parquet")
                and obj["Size"] > 0
                for obj in page.get("Contents", [])
            ):
                parquet_found = True
                break
    
        if not parquet_found:
            raise RuntimeError(
                f"No valid Parquet files found for {dataset}"
            )
    
        # Confirm Spark can read the snapshot.
        snapshot_df = spark.read.parquet(output_path)
    
        if snapshot_df.limit(1).count() == 0:
            raise RuntimeError(
                f"Empty Bronze snapshot: {dataset}"
            )
    
        snapshot_locations[dataset] = output_path
    
        print(
            f"VALIDATED: {dataset} -> {output_path}"
        )
    
    print("All five Bronze snapshots validated.")

    
    # --------------------------------------------------
    # Update Glue Catalog for changed datasets only
    # --------------------------------------------------
    
    glue = boto3.client("glue", region_name="us-east-1")
    
    original_tables = {}
    updated_datasets = []
    
    try:
        # Save existing definitions for changed tables.
        for dataset in changed_bronze_datasets:
    
            table_name = f"{dataset}_staging"
    
            response = glue.get_table(
                DatabaseName=DATABASE,
                Name=table_name
            )
    
            original_tables[dataset] = response["Table"]
    
        # Publish only changed datasets.
        for dataset in changed_bronze_datasets:
    
            table_name = f"{dataset}_staging"
            table = original_tables[dataset]
    
            table_input = {
                "Name": table["Name"],
                "StorageDescriptor": {
                    **table["StorageDescriptor"],
                    "Columns": [
                        {
                            "Name": field.name,
                            "Type": field.dataType.simpleString()
                        }
                        for field in dataframes[dataset].schema.fields
                    ]
                },
                "TableType": table.get(
                    "TableType",
                    "EXTERNAL_TABLE"
                ),
                "Parameters": table.get("Parameters", {})
            }
    
            table_input["StorageDescriptor"]["Location"] = (
                snapshot_locations[dataset]
            )
    
            glue.update_table(
                DatabaseName=DATABASE,
                TableInput=table_input
            )
    
            updated_datasets.append(dataset)
    
            print(
                f"Published CHANGED {table_name}: "
                f"{snapshot_locations[dataset]}"
            )
    
    except Exception:
    
        print("Publication failed. Attempting rollback.")
    
        for dataset in reversed(updated_datasets):
    
            table = original_tables[dataset]
    
            rollback_input = {
                "Name": table["Name"],
                "StorageDescriptor": table["StorageDescriptor"],
                "TableType": table.get(
                    "TableType",
                    "EXTERNAL_TABLE"
                ),
                "Parameters": table.get("Parameters", {})
            }
    
            try:
                glue.update_table(
                    DatabaseName=DATABASE,
                    TableInput=rollback_input
                )
    
                print(f"Rolled back {dataset}")
    
            except Exception as rollback_error:
                print(
                    f"Rollback failed for {dataset}: "
                    f"{rollback_error}"
                )
    
        raise
    
    print(
        f"Bronze publication completed: "
        f"{len(updated_datasets)} tables updated, "
        f"{len(DATASETS) - len(updated_datasets)} unchanged."
    )


# --------------------------------------------------
# Publish Bronze execution status for orchestration
# --------------------------------------------------

bronze_status = {
    "run_id": run_id,
    "status": "success",
    "changes_detected": not skip_bronze,
    "changed_datasets": sorted(changed_bronze_datasets),
    "bronze_processed": not skip_bronze,
    "catalog_database": DATABASE,
    "bronze_prefix": BRONZE_PREFIX
}

status_key = (
    f"temp/pipeline-status/{run_id}/bronze-status.json"
)

s3.put_object(
    Bucket=BUCKET,
    Key=status_key,
    Body=json.dumps(
        bronze_status,
        indent=2
    ).encode("utf-8"),
    ContentType="application/json"
)

print(
    f"Bronze execution status written: "
    f"s3://{BUCKET}/{status_key}"
)

print(
    "BRONZE COMPLETE: "
    + (
        "Source changes processed."
        if not skip_bronze
        else "No changes; downstream processing unnecessary."
    )
)
