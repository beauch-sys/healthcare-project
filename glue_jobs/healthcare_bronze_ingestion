# --------------------------------------------------
# Locate the latest completed ingestion manifest
# --------------------------------------------------


def find_latest_manifest():
    paginator = s3.get_paginator("list_objects_v2")
    manifests = []

    for page in paginator.paginate(
        Bucket=BUCKET,
        Prefix=MANIFEST_PREFIX
    ):
        for obj in page.get("Contents", []):
            key = obj["Key"]

            if not key.endswith("/manifest.json"):
                continue

            # Extract the run ID from the manifest path.
            run_id = key.split("/")[-2]

            # Only accept production timestamp run IDs.
            if not re.fullmatch(r"\d{8}T\d{6}Z", run_id):
                continue

            manifests.append(key)

    if not manifests:
        raise RuntimeError(
            "No production ingestion manifests found."
        )

    # Production run IDs sort chronologically.
    return max(manifests)


# --------------------------------------------------
# Select ingestion manifest
