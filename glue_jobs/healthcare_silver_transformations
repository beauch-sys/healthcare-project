    ]
    
    negative_hours = fact_daily_staffing.filter(
        reduce(
            lambda a, b: a | b,
            [F.col(c) < 0 for c in hour_columns]
        )
    ).count()
    
    if negative_hours > 0:
        raise RuntimeError(
            f"Found {negative_hours} records "
            "with negative staffing hours."
        )
    
    # Standardize census and date keys
    fact_daily_staffing = (
        fact_daily_staffing
        .withColumnRenamed("mdscensus", "resident_census")
        .withColumn(
            "date_id",
            F.date_format("work_date", "yyyyMMdd").cast("int")
        )
        .withColumn(
            "is_valid_census",
            F.col("resident_census") > 0
        )
    )
    
    # Create standardized hours for each staffing category
    for role, source_column in STAFFING_ROLES.items():
        fact_daily_staffing = (
            fact_daily_staffing
            .withColumnRenamed(
                source_column, f"{role}_hours"
            )
            .withColumnRenamed(
                f"{source_column}_emp",
                f"{role}_employee_hours"
            )
            .withColumnRenamed(
                f"{source_column}_ctr",
                f"{role}_contract_hours"
            )
        )
    
    # Build aggregate nursing-hour totals
    def sum_columns(column_names):
        return reduce(
            lambda a, b: a + b,
            [F.col(c) for c in column_names]
        )
    
    fact_daily_staffing = (
        fact_daily_staffing
        .withColumn(
            "total_nursing_hours",
            sum_columns([
                f"{role}_hours"
                for role in STAFFING_ROLES
            ])
        )
        .withColumn(
            "total_employee_hours",
            sum_columns([
                f"{role}_employee_hours"
                for role in STAFFING_ROLES
            ])
        )
        .withColumn(
            "total_contract_hours",
            sum_columns([
                f"{role}_contract_hours"
                for role in STAFFING_ROLES
            ])
        )
    )
    
