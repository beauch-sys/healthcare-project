        .withColumn(
            "contract_labor_rate",
            F.when(
                F.col("total_nursing_hours") > 0,
                F.col("total_contract_hours")
                / F.col("total_nursing_hours")
            ).otherwise(F.lit(None).cast("double"))
        )
    )
    
    
