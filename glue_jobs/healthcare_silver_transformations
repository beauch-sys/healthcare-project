        print("Updated existing fact_quality_measures table.")
    
    except glue_client.exceptions.EntityNotFoundException:
        glue_client.create_table(
            DatabaseName=quality_database,
            TableInput=quality_table_input
        )
    
        print("Created fact_quality_measures table.")
    
    print(
        f"Registered {quality_database}.{quality_table_name} "
        f"at {quality_s3_path}"
    )
    
    # ----------------------------------------
    # Transform fact_state_benchmarks
    # ----------------------------------------
    
    benchmark_df = spark.table(
        "healthcare_bronze.state_us_averages_staging"
    )
    
    # Map Bronze columns to standardized Silver columns
    BENCHMARK_COLUMNS = {
        "nurse_aide_hprd":
            "reported nurse aide staffing hours per resident per day",
    
        "lpn_hprd":
            "reported lpn staffing hours per resident per day",
    
        "rn_hprd":
            "reported rn staffing hours per resident per day",
    
        "licensed_hprd":
            "reported licensed staffing hours per resident per day",
    
        "total_hprd":
            "reported total nurse staffing hours per resident per day",
    
        "weekend_total_hprd":
            "total number of nurse staff hours per resident per day on the weekend",
    
        "weekend_rn_hprd":
            "registered nurse hours per resident per day on the weekend"
    }
    
    fact_state_benchmarks = benchmark_df.select(
        F.upper(
            F.trim(F.col("`state or nation`"))
        ).alias("geography_code"),
    
        F.when(
            F.upper(F.trim(F.col("`state or nation`"))) == "NATION",
            F.lit("NATIONAL")
        ).otherwise(F.lit("STATE")).alias("geography_type"),
    
        F.to_date(
            F.col("`processing date`"),
            "yyyy-MM-dd"
        ).alias("processing_date"),
    
        *[
            F.expr(
                f"try_cast(`{source_column}` AS DOUBLE)"
            ).alias(target_column)
            for target_column, source_column
            in BENCHMARK_COLUMNS.items()
        ],
    
        F.col("source_file")
    )
    
    # ----------------------------------------
    # Validate geographic business keys
    # ----------------------------------------
    
    total_benchmark_records = fact_state_benchmarks.count()
    
    invalid_geographies = fact_state_benchmarks.filter(
        F.col("geography_code").isNull()
        | (F.col("geography_code") == "")
        | F.col("processing_date").isNull()
    ).count()
    
    if invalid_geographies > 0:
        raise RuntimeError(
            f"Found {invalid_geographies} invalid benchmark keys."
        )
    
    unique_benchmark_keys = (
        fact_state_benchmarks
        .select("geography_code", "processing_date")
        .distinct()
        .count()
    )
    
    if unique_benchmark_keys != total_benchmark_records:
        raise RuntimeError(
            "Duplicate geography/date benchmark keys detected."
        )
    
    # ----------------------------------------
    # Validate state and national records
    # ----------------------------------------
    
    fact_state_benchmarks.groupBy(
        "geography_type"
    ).count().show()
    
    # ----------------------------------------
    # Validate missing benchmark values
    # ----------------------------------------
    
    fact_state_benchmarks.select([
        F.sum(
            F.when(
                F.col(column).isNull(), 1
            ).otherwise(0)
        ).alias(column)
        for column in BENCHMARK_COLUMNS
    ]).show(truncate=False)
    
    print(
        f"Benchmark records: {total_benchmark_records}"
    )
    print(
        f"Unique geography/date keys: {unique_benchmark_keys}"
    )
    
    print("fact_state_benchmarks transformation completed.")
    
    # ----------------------------------------
    # Write fact_state_benchmarks to Silver
    # ----------------------------------------
    
    benchmark_table_name = "fact_state_benchmarks"
    
    benchmark_run_id = datetime.now(
        timezone.utc
    ).strftime("%Y%m%dT%H%M%SZ")
    
    benchmark_s3_prefix = (
        f"{SILVER_PREFIX}/{benchmark_table_name}/runs/{benchmark_run_id}/"
    )
    
    benchmark_s3_path = (
        f"s3://{args['S3_BUCKET']}/{benchmark_s3_prefix}"
    )
    
    # Write Parquet snapshot
    (
        fact_state_benchmarks
        .write
        .mode("errorifexists")
        .parquet(benchmark_s3_path)
    )
    
    # Read the snapshot back for validation
    written_benchmarks = spark.read.parquet(
        benchmark_s3_path
    )
    
    written_benchmark_count = written_benchmarks.count()
    
    if written_benchmark_count != total_benchmark_records:
        raise RuntimeError(
            f"Benchmark row count mismatch: "
            f"expected={total_benchmark_records}, "
            f"actual={written_benchmark_count}"
        )
    
    # Verify Spark's successful-write marker
    s3_client.head_object(
        Bucket=args["S3_BUCKET"],
        Key=benchmark_s3_prefix + "_SUCCESS"
    )
    
    # Verify at least one nonempty Parquet file
    paginator = s3_client.get_paginator("list_objects_v2")
    
    parquet_found = False
    
    for page in paginator.paginate(
        Bucket=args["S3_BUCKET"],
        Prefix=benchmark_s3_prefix
    ):
        for obj in page.get("Contents", []):
            if (
                obj["Key"].endswith(".parquet")
                and obj["Size"] > 0
            ):
                parquet_found = True
                break
    
        if parquet_found:
            break
    
    if not parquet_found:
        raise RuntimeError(
            "No nonempty Parquet files found "
            "in benchmark snapshot."
        )
    
    print(
        f"Benchmark snapshot validated: {benchmark_s3_path}"
    )
    print(
        f"Published benchmark records: {written_benchmark_count}"
    )
    
    # ----------------------------------------
    # Register fact_state_benchmarks
    # in the Glue Data Catalog
    # ----------------------------------------
    
    benchmark_database = SILVER_DATABASE
    
    # Build catalog schema from validated Parquet data
    benchmark_columns = [
        {
            "Name": field.name,
            "Type": field.dataType.simpleString()
        }
        for field in written_benchmarks.schema.fields
    ]
    
    benchmark_table_input = {
        "Name": benchmark_table_name,
        "TableType": "EXTERNAL_TABLE",
        "Parameters": {
            "classification": "parquet",
            "EXTERNAL": "TRUE",
            "parquet.compression": "snappy"
        },
        "StorageDescriptor": {
            "Columns": benchmark_columns,
            "Location": benchmark_s3_path,
            "InputFormat": (
                "org.apache.hadoop.hive.ql.io.parquet."
                "MapredParquetInputFormat"
            ),
            "OutputFormat": (
                "org.apache.hadoop.hive.ql.io.parquet."
                "MapredParquetOutputFormat"
            ),
            "SerdeInfo": {
                "SerializationLibrary": (
                    "org.apache.hadoop.hive.ql.io.parquet.serde."
                    "ParquetHiveSerDe"
                )
            }
        }
    }
    
    # Create or update the catalog table
    try:
        glue_client.get_table(
            DatabaseName=benchmark_database,
            Name=benchmark_table_name
        )
    
        glue_client.update_table(
            DatabaseName=benchmark_database,
            TableInput=benchmark_table_input
        )
    
        print("Updated existing fact_state_benchmarks table.")
    
    except glue_client.exceptions.EntityNotFoundException:
        glue_client.create_table(
            DatabaseName=benchmark_database,
            TableInput=benchmark_table_input
        )
    
        print("Created fact_state_benchmarks table.")
    
    print(
        f"Registered {benchmark_database}.{benchmark_table_name} "
        f"at {benchmark_s3_path}"
    )

else:
    print("Silver completed successfully without processing.")
