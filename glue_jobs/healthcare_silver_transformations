        F.col("source_file"),
    
        *[
            F.expr(
                f"try_cast(`{column}` AS DOUBLE)"
            ).alias(column)
            for column in numeric_columns
        ]
    )
    
    # Reject missing business keys and invalid numeric values
    invalid_records = fact_daily_staffing.filter(
        F.col("facility_id").isNull()
        | (F.col("facility_id") == "")
        | F.col("work_date").isNull()
        | reduce(
            lambda a, b: a | b,
            [F.col(c).isNull() for c in numeric_columns]
        )
    ).count()
    
